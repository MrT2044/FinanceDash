# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase -> Project Settings -> API Keys (beginnt mit "sb_secret_").
# Nur serverseitig verwenden, niemals ein NEXT_PUBLIC_ Prefix vergeben.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Fuer den oeffentlichen Betrieb erforderlich
# ---------------------------------------------------------------------------

# Oeffentliche Adresse der Anwendung, ohne abschliessenden Schraegstrich.
# Wird fuer die Links in Bestaetigungs- und Passwort-Reset-Mails verwendet.
# Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Rate-Limiting ueber Upstash Redis (kostenlos: https://console.upstash.com).
# OHNE diese Werte greift nur ein In-Memory-Limit, das pro Serverprozess zaehlt
# und auf serverlosen Plattformen wie Vercel praktisch wirkungslos ist.
# Fuer eine oeffentlich erreichbare Installation dringend setzen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Begrenzt die Registrierung auf bestimmte Adressen (kommagetrennt).
# Leer lassen = jeder kann sich registrieren.
# Beispiel: REGISTRATION_ALLOWLIST="anna@example.de,ben@example.de"
REGISTRATION_ALLOWLIST=

# Automatische Abmeldung nach so vielen Minuten ohne Seitenaufruf.
# Standard: 30
SESSION_IDLE_TIMEOUT_MINUTES=30

# KI-Fallback fuer unbekannte Haendler beim Import.
# Kostenloser Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
